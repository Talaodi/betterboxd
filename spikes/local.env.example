# 复制本文件为 local.env 并填入真实值（local.env 已被 .gitignore 排除，勿提交）
# 用法: set -a; source spikes/local.env; cargo run -p betterboxd-core --bin spike_tmdb
#       set -a; source spikes/local.env; cargo run -p betterboxd-core --bin spike_llm

# TMDB API Key（v3 auth，即 Bearer token）
TMDB_KEY=

# 课程平台 LLM 端点（到 /v1 为止，不含 /chat/completions）
COURSE_ENDPOINT=
COURSE_KEY=
COURSE_MODEL=
